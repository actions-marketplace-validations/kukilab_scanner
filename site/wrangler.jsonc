{
  // KukiLab website — static assets on Cloudflare Workers.
  // Deployed by Workers Builds from github.com/kukilab/scanner, root directory: site/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kukilab-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "kukilab.dev", "custom_domain": true },
    { "pattern": "www.kukilab.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
